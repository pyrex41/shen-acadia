database module Backend exposing
  ( endpoint addFood
  , endpoint getFoods
  )


import Cookies exposing (Cookies)
import Rows exposing (..)
import Security exposing (Unrestricted(..))
import Sequence as Seq exposing (Sequence)
import Table exposing (..)


-- Canonical Acadia foods example (01-foods). Used as the live server
-- for the Shen client and the shen-rel comparison. Unrestricted on
-- purpose: this is the vendor's public surface, not a production policy.


type alias Food =
  { id : FoodID
  , name : String
  }


type FoodID = FoodID UInt64


foods : Table Unrestricted Food
foods :=
  table
    { primary = .id
    , security = Security.unrestricted
    , indexes = []
    , constraints = []
    }


foodIDs : Sequence FoodID
foodIDs :=
  Seq.uint64 FoodID


addFood : Cookies -> String -> Transaction ()
addFood _ name =
  let
    id := Seq.next foodIDs
  in
  insert foods Unrestricted
    { id = id
    , name = name
    }


getFoods : Cookies -> Transaction (Rows String)
getFoods _ =
  access foods Unrestricted
    |> map .name
    |> selectAll
